# このファイルを .env.local にコピーして設定。キーをチャットやGitへ貼らないでください。
ANTHROPIC_API_KEY=
# 既存の鍵ファイルを使う場合は、上を空欄にして絶対パスだけ指定できます。
ANTHROPIC_API_KEY_FILE=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 公開版はログインなしで開き、回数の上限で費用を抑えます（ADR 0012）。
# 独自ドメインを追加した場合は、その https:// から始まるオリジンを指定します。
APP_ORIGIN=
# 公開版の Claude との会話の回数上限（1 日あたり、日本時間の 0 時で切り替わる）。省略すると 20 回・150 回。
LIMIT_PER_CLIENT_PER_DAY=
LIMIT_GLOBAL_PER_DAY=
