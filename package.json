{
  "name": "sakiyomi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:roadmap": "node scripts/build-sapporo-roadmap.mjs --check && node docs/prototypes/sapporo-roadmap.test.cjs",
    "test:e2e": "next build && tsx --test --test-concurrency=1 e2e/*.test.ts",
    "test:e2e:links": "NEXT_PUBLIC_PERSONA_URL=http://127.0.0.1:4317/ NEXT_PUBLIC_KAGAMI_URL=https://kagami.example.com/ npm run test:e2e",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "ai": "^7.0.163",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
